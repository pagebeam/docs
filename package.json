{
  "name": "pagebeam-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run brand && astro dev",
    "brand": "node brand/scripts/generate.mjs --name \"pagebeam docs\" --label Documentation",
    "build": "npm run brand && astro build",
    "lint": "eslint .",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test 'brand/test/*.test.mjs' 'test/*.test.mjs'",
    "test:dist": "node --test 'test/dist/*.test.mjs'",
    "drift": "pagebeam check --profile enforce-all",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test && npm run build && npm run test:dist"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/starlight": "^0.42.3",
    "@iconify-json/simple-icons": "^1.2.97",
    "@iconify-json/solar": "^1.2.12",
    "astro": "^7.3.4",
    "sharp": "^0.35.4",
    "starlight-llms-txt": "^0.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.2.0",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "opentype.js": "1.3.4",
    "pagebeam": "^0.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22"
  }
}
